---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
}

const baseSite = Astro.site || 'https://washer-dryer-repair-tx.netlify.app';
const canonicalUrl = Astro.props.canonical ?? new URL(Astro.url.pathname, baseSite).href;
const PHONE = "(888) 277-7325";
const PHONE_HREF = "tel:+18882777325";

const {
  title = "Texas Washer & Dryer Repair | Same-Day Service | Dallas, Houston & Austin",
  description = "Professional washer and dryer repair across Texas. Same-day service in Dallas, Houston, Austin, San Antonio & Fort Worth. Licensed technicians, 90-day warranty. Call now!",
  keywords = "washer repair Dallas, dryer service Houston, emergency appliance repair Texas, washer repair Austin, dryer repair San Antonio, appliance repair Fort Worth",
} = Astro.props;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Texas Washer & Dryer Repair",
  "description": description,
  "url": canonicalUrl,
  "telephone": "+18882777325",
  "priceRange": "$$",
  "areaServed": [
    { "@type": "City", "name": "Dallas" },
    { "@type": "City", "name": "Houston" },
    { "@type": "City", "name": "Austin" },
    { "@type": "City", "name": "San Antonio" },
    { "@type": "City", "name": "Fort Worth" }
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    "opens": "07:00",
    "closes": "21:00"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Appliance Repair Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Washer Repair" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Dryer Repair" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Emergency Appliance Repair" } }
    ]
  }
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Texas Washer & Dryer Repair" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Texas Washer & Dryer Repair" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Local Business JSON-LD Schema -->
    <script type="application/ld+json" set:html={schema} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" as="style" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    </noscript>
  </head>
  <body style="font-family: 'Inter', sans-serif;" class="antialiased text-slate-800 bg-[#0f2057]">
    <header id="site-header" class="sticky top-0 z-50 bg-[#1e3a8a] shadow-lg">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between" aria-label="Main navigation">

        <a href="/" class="flex items-center gap-3 group" aria-label="Texas Washer & Dryer Repair Home">
          <div class="w-10 h-10 bg-orange-500 rounded-lg flex items-center justify-center group-hover:bg-orange-400 transition-colors flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="white" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
            </svg>
          </div>
          <div class="hidden sm:block">
            <p class="text-white font-bold text-lg leading-tight">TX Washer &amp; Dryer</p>
            <p class="text-blue-200 text-xs font-medium tracking-wide">APPLIANCE REPAIR</p>
          </div>
        </a>

        <ul class="hidden lg:flex items-center gap-8 text-sm font-semibold text-blue-100">
          <li><a href="#services" class="hover:text-white transition-colors">Services</a></li>
          <li><a href="#process" class="hover:text-white transition-colors">Our Process</a></li>
          <li><a href="#service-areas" class="hover:text-white transition-colors">Service Areas</a></li>
          <li><a href="#faq" class="hover:text-white transition-colors">FAQ</a></li>
        </ul>

        <a
          href={PHONE_HREF}
          id="nav-call-btn"
          class="flex items-center gap-2 bg-orange-500 hover:bg-orange-400 text-white font-bold px-5 py-2.5 rounded-lg transition-all duration-200 shadow-md hover:shadow-orange-500/30 hover:scale-105 text-sm"
          aria-label={`Call us at ${PHONE}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          <span class="hidden sm:inline">{PHONE}</span>
          <span class="sm:hidden">Call Now</span>
        </a>
      </nav>
    </header>

    <main class="min-h-[calc(100vh-8rem)]">
      <slot />
    </main>

    <footer id="site-footer" class="bg-[#0f2057] text-blue-200" aria-label="Site footer">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-10">

          <div class="lg:col-span-1">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-orange-500 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="white" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
                </svg>
              </div>
              <div>
                <p class="text-white font-bold text-base leading-tight">TX Washer &amp; Dryer Repair</p>
                <p class="text-blue-300 text-xs">Licensed · Insured · Texas</p>
              </div>
            </div>
            <p class="text-blue-300 text-sm leading-relaxed mb-5">
              Professional appliance repair serving Texas homeowners since 2009. Trusted by 10,000+ customers across the Lone Star State.
            </p>
            <a href={PHONE_HREF} class="text-orange-400 hover:text-orange-300 font-bold text-lg transition-colors">
              {PHONE}
            </a>
          </div>

          <div>
            <h3 class="text-white font-bold text-sm uppercase tracking-widest mb-5">Services</h3>
            <ul class="space-y-2.5 text-sm">
              <li>
                <a href="/dallas/washer-repair" class="text-blue-300 hover:text-white transition-colors">Washer Repair</a>
              </li>
              <li>
                <a href="/dallas/dryer-repair" class="text-blue-300 hover:text-white transition-colors">Dryer Repair</a>
              </li>
              <li>
                <a href="/dallas/emergency-repair" class="text-blue-300 hover:text-white transition-colors">Emergency Repair</a>
              </li>
              <li>
                <a href="/dallas/preventive-maintenance" class="text-blue-300 hover:text-white transition-colors">Preventive Maintenance</a>
              </li>
              <li>
                <a href="/dallas/all-brands-serviced" class="text-blue-300 hover:text-white transition-colors">All Brands Serviced</a>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="text-white font-bold text-sm uppercase tracking-widest mb-5">Service Areas</h3>
            <ul class="space-y-2.5 text-sm">
              <li>
                <a href="/dallas/washer-repair" class="text-blue-300 hover:text-white transition-colors">Dallas, TX</a>
              </li>
              <li>
                <a href="/houston/washer-repair" class="text-blue-300 hover:text-white transition-colors">Houston, TX</a>
              </li>
              <li>
                <a href="/austin/washer-repair" class="text-blue-300 hover:text-white transition-colors">Austin, TX</a>
              </li>
              <li>
                <a href="/san-antonio/washer-repair" class="text-blue-300 hover:text-white transition-colors">San Antonio, TX</a>
              </li>
              <li>
                <a href="/fort-worth/washer-repair" class="text-blue-300 hover:text-white transition-colors">Fort Worth, TX</a>
              </li>
              <li><span class="text-blue-400 text-xs">+ All of Texas</span></li>
            </ul>
          </div>

          <div>
            <h3 class="text-white font-bold text-sm uppercase tracking-widest mb-5">Trust &amp; Info</h3>
            <ul class="space-y-3 text-sm">
              {[
                "✅ EPA Certified Technicians",
                "🛡️ 90-Day Repair Warranty",
                "🔧 OEM-Quality Parts",
                "💲 Flat-Rate Pricing",
                "⭐ 4.9/5 Customer Rating",
                "📅 7-Days-a-Week Service",
              ].map(item => (
                <li class="text-blue-300 text-sm">{item}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="border-t border-white/10 pt-7 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-blue-400">
          <p>© {new Date().getFullYear()} Texas Washer &amp; Dryer Repair. All rights reserved.</p>
          <p>Serving: Dallas · Houston · Austin · San Antonio · Fort Worth · All of Texas</p>
        </div>
      </div>
    </footer>
  </body>
</html>
